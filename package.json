{
  "name": "sole-matrix-core",
  "version": "0.1.0",
  "private": true,
  "description": "SOLE//MATRIX Core v0.1 recommendation logic and golden tests.",
  "type": "module",
  "scripts": {
    "demo": "tsx src/demo/runRecommendationDemo.ts",
    "demo:gemini": "tsx src/demo/runGeminiRecommendationDemo.ts",
    "market:collect": "tsx scripts/market-collect.ts",
    "market:smoke": "node --conditions=react-server --import tsx scripts/market-smoke.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "web:dev": "next dev",
    "web:build": "next build",
    "web:start": "next start"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tsx": "latest",
    "typescript": "5.9.3",
    "vitest": "latest"
  },
  "dependencies": {
    "next": "^16.2.11",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1"
  }
}
